<%
  // Sidebar navigation. `active` is the current page key.
  var active = (typeof active !== 'undefined' && active) ? active : '';
  var icons = {
    dashboard: '<path d="M3 13h8V3H3zM13 21h8V11h-8zM3 21h8v-6H3zM13 3v6h8V3z"/>',
    validate: '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/>',
    'bulk-validate': '<path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>',
    messages: '<path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4z"/>',
    bulk: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
    inbox: '<path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/>',
    'api-keys': '<path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.78 7.78 5.5 5.5 0 0 1 7.78-7.78zm0 0L15.5 7.5m0 0 3 3L22 7l-3-3m-3.5 3.5L19 4"/>'
  };
  function link(key, href, label) {
    return '<a href="' + href + '" class="' + (active === key ? 'active' : '') + '"' +
      (active === key ? ' aria-current="page"' : '') + '>' +
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
      icons[key] + '</svg><span>' + label + '</span></a>';
  }
  var mark = '<span class="app-brand-mark"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg></span>';
%>
<% if (typeof username !== 'undefined' && username) { %>
<div class="app-topbar">
  <a class="app-brand" href="/"><%- mark %><span>WhatsApp Hub</span></a>
  <button type="button" class="btn btn-sm btn-outline-light" id="sidebar-toggle"
          aria-controls="app-sidebar" aria-expanded="false" aria-label="Toggle navigation">Menu</button>
</div>
<nav class="app-sidebar" id="app-sidebar" aria-label="Main">
  <a class="app-brand" href="/"><%- mark %><span>WhatsApp Hub<small>Messaging &amp; validation</small></span></a>

  <div class="app-nav">
    <div class="app-nav-label">Overview</div>
    <%- link('dashboard', '/', 'Dashboard') %>
    <div class="app-nav-label">Numbers</div>
    <%- link('validate', '/validate', 'Validate') %>
    <%- link('bulk-validate', '/validate/bulk', 'Bulk validate') %>
    <div class="app-nav-label">Messaging</div>
    <%- link('inbox', '/inbox', 'Inbox') %>
    <%- link('messages', '/messages', 'Send message') %>
    <%- link('bulk', '/bulk', 'Bulk send') %>
    <div class="app-nav-label">Developers</div>
    <%- link('api-keys', '/settings/api-keys', 'API keys') %>
  </div>

  <div class="app-user">
    <span>Signed in as<br /><strong><%= username %></strong></span>
    <form action="/logout" method="post" class="m-0">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <button type="submit" class="btn btn-sm btn-outline-light">Log out</button>
    </form>
  </div>
</nav>
<script nonce="<%= cspNonce %>">
  (function () {
    var btn = document.getElementById('sidebar-toggle');
    var nav = document.getElementById('app-sidebar');
    if (!btn || !nav) return;
    btn.addEventListener('click', function () {
      var open = nav.classList.toggle('open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  })();
</script>
<% } %>
