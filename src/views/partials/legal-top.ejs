<%
  // Shared header for the public legal pages (privacy, terms, data deletion).
  // Expects: page ('privacy' | 'terms' | 'data-deletion'), heading, updated.
  var legalLinks = [
    ['privacy', '/privacy-policy', 'Privacy Policy'],
    ['terms', '/terms', 'Terms of Service'],
    ['data-deletion', '/data-deletion', 'Data Deletion']
  ];
%>
<main class="container py-5">
  <article class="bg-white rounded shadow-sm p-4 p-md-5 mx-auto legal" style="max-width: 900px;">
    <nav class="legal-nav mb-4" aria-label="Legal">
      <% legalLinks.forEach(function (l) { %>
        <a href="<%= l[1] %>" class="<%= page === l[0] ? 'active' : '' %>"<%- page === l[0] ? ' aria-current="page"' : '' %>><%= l[2] %></a>
      <% }); %>
    </nav>
    <header class="mb-4">
      <h1><%= heading %></h1>
      <p class="text-muted mb-0">WhatsApp Messaging · Last updated <%= updated %></p>
    </header>
