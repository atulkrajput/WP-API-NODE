<!doctype html>
<html lang="en">
<head>
  <% title = 'API keys — WhatsApp Hub'; %>
  <%- include('partials/head', { title: title }) %>
</head>
<body>
  <%- include('partials/navbar', { username: username, active: 'api-keys' }) %>

  <main class="app-main">
    <%- include('partials/flash') %>

    <div class="page-head">
      <div>
        <h1>API keys</h1>
        <p>One key per project. Every project sends through the same verified WhatsApp number.</p>
      </div>
    </div>

    <% if (!senderConfigured) { %>
      <div class="alert alert-warning">WhatsApp sender is not configured yet (WHATSAPP_TOKEN / PHONE_NUMBER_ID). API calls will authenticate but sends will fail.</div>
    <% } %>
    <% if (loadError) { %>
      <div class="alert alert-danger"><%= loadError %></div>
    <% } %>

    <% if (newKey) { %>
      <div class="card mb-4" style="border-color: var(--brand);">
        <div class="card-body">
          <div class="fw-semibold mb-1">New key for “<%= newKey.name %>”</div>
          <p class="small text-muted mb-2">Copy it now. It is stored hashed and will not be shown again.</p>
          <div class="input-group">
            <input type="text" readonly class="form-control font-monospace" id="new-key" value="<%= newKey.key %>" />
            <button class="btn btn-success" type="button" id="copy-key">Copy</button>
          </div>
        </div>
      </div>
    <% } %>

    <div class="row g-4">
      <div class="col-xl-7">
        <div class="card mb-4">
          <div class="card-header">Create a key</div>
          <div class="card-body">
            <form action="/settings/api-keys" method="post" class="row g-2">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <div class="col-sm-8">
                <input type="text" name="name" class="form-control" placeholder="Project name, e.g. CRM, Shop, HR portal" maxlength="120" required />
              </div>
              <div class="col-sm-4 d-grid">
                <button type="submit" class="btn btn-success">Create key</button>
              </div>
            </form>
          </div>
        </div>

        <div class="card">
          <div class="card-header">Projects</div>
          <div class="table-responsive">
            <table class="table table-sm table-hover small align-middle">
              <thead><tr><th>Project</th><th>Key</th><th>Msgs (30d)</th><th>Last used</th><th>Status</th><th></th></tr></thead>
              <tbody>
                <% if (clients.length) { %>
                  <% clients.forEach(function (c) { %>
                    <tr>
                      <td class="fw-semibold"><%= c.name %></td>
                      <td><code><%= c.key_prefix %>…</code></td>
                      <td><%= c.messages_30d || 0 %></td>
                      <td class="text-muted"><%= c.last_used_at || 'never' %></td>
                      <td><span class="badge <%= c.is_active ? 'bg-success' : 'bg-secondary' %>"><%= c.is_active ? 'active' : 'revoked' %></span></td>
                      <td class="text-end">
                        <% if (c.is_active) { %>
                          <form action="/settings/api-keys/<%= c.id %>/revoke" method="post" class="m-0 revoke-form">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Revoke</button>
                          </form>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr><td colspan="6" class="text-muted">No keys yet. Create one for each project that should send WhatsApp messages.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div class="col-xl-5">
        <div class="card">
          <div class="card-header">Quickstart</div>
          <div class="card-body small">
            <p class="mb-2 fw-semibold">Send a template</p>
<pre class="code-box mb-3">curl -X POST <%= baseUrl %>/api/v1/messages \
  -H "Authorization: Bearer $WA_KEY" \
  -H "Content-Type: application/json" \
  -d '{
    "to": "+919876543210",
    "template": {
      "name": "order_update",
      "language": "en_US",
      "variables": ["Asha", "#1042"]
    },
    "reference": "order-1042"
  }'</pre>
            <p class="mb-2 fw-semibold">Check status</p>
<pre class="code-box mb-3">curl <%= baseUrl %>/api/v1/messages/123 \
  -H "Authorization: Bearer $WA_KEY"</pre>
            <p class="mb-2 fw-semibold">Validate format (free)</p>
<pre class="code-box mb-3">curl -X POST <%= baseUrl %>/api/v1/validate \
  -H "Authorization: Bearer $WA_KEY" \
  -H "Content-Type: application/json" \
  -d '{"number":"9876543210","defaultCountry":"IN"}'</pre>
            <ul class="text-muted mb-0 ps-3">
              <li>Free text: <code>{"to":"…","type":"text","text":"Hi"}</code> — only inside a 24-hour customer window.</li>
              <li>Status flow: accepted → sent → delivered → read (or failed).</li>
              <li>Limit: <%= typeof rateLimit !== 'undefined' ? rateLimit : 120 %> requests/min per key. Over it → HTTP 429.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script nonce="<%= cspNonce %>">
    (function () {
      var btn = document.getElementById('copy-key');
      if (btn) {
        btn.addEventListener('click', function () {
          var input = document.getElementById('new-key');
          input.select();
          (navigator.clipboard ? navigator.clipboard.writeText(input.value) : Promise.reject())
            .catch(function () { document.execCommand('copy'); })
            .finally(function () { btn.textContent = 'Copied'; });
        });
      }
      document.querySelectorAll('.revoke-form').forEach(function (f) {
        f.addEventListener('submit', function (e) {
          if (!confirm('Revoke this key? Any project using it stops sending immediately.')) e.preventDefault();
        });
      });
    })();
  </script>
</body>
</html>
