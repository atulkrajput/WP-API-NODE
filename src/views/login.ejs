<!doctype html>
<html lang="en">
<head>
  <% title = 'Sign in — WhatsApp Hub'; %>
  <%- include('partials/head', { title: title }) %>
</head>
<body>
  <div class="auth-wrap">
    <div class="auth-card">
      <div class="auth-brand">
        <span class="app-brand-mark"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg></span>
        WhatsApp Hub
      </div>
      <div class="card">
        <div class="card-body">
          <h1 class="h5 mb-1">Admin sign in</h1>
          <p class="text-muted small mb-3">Manage messaging, validation and API access.</p>

          <%- include('partials/flash') %>

          <% if (error) { %>
            <div class="alert alert-danger" role="alert"><%= error %></div>
          <% } %>

          <form action="/login" method="post" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <div class="mb-3">
              <label for="username" class="form-label">Username</label>
              <input type="text" class="form-control" id="username" name="username"
                     value="<%= username %>" autocomplete="username" required autofocus />
            </div>
            <div class="mb-3">
              <label for="password" class="form-label">Password</label>
              <input type="password" class="form-control" id="password" name="password"
                     autocomplete="current-password" required />
            </div>
            <button type="submit" class="btn btn-success w-100">Sign in</button>
          </form>
        </div>
      </div>
      <p class="text-center text-muted small mt-3 mb-0"><a href="/privacy-policy" class="text-muted">Privacy policy</a></p>
    </div>
  </div>
</body>
</html>
