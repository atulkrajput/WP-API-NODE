<!doctype html>
<html lang="en">
<head>
  <% title = 'Dashboard — WhatsApp Messaging'; %>
  <%- include('partials/head', { title: title }) %>
</head>
<body>
  <%- include('partials/navbar', { username: username, active: 'dashboard' }) %>

  <main class="app-main">
    <%- include('partials/flash') %>

    <div class="page-head">
      <div>
        <h1>Dashboard</h1>
        <p>Last 30 days across the admin UI and every API project.</p>
      </div>
      <div class="d-flex gap-2">
        <a href="/messages" class="btn btn-success btn-sm">Send message</a>
        <a href="/bulk" class="btn btn-outline-success btn-sm">New bulk job</a>
      </div>
    </div>

    <% if (typeof summaryErrors !== 'undefined' && summaryErrors && summaryErrors.length) { %>
      <div class="alert alert-warning" role="alert">
        Some summary panels couldn't be loaded right now (<%= summaryErrors.join(', ') %>).
        The rest of the dashboard is still available.
      </div>
    <% } %>

    <% var k = (typeof kpis !== 'undefined' && kpis) ? kpis : { total: 0, delivered: 0, read: 0, failed: 0, inFlight: 0, deliveryRate: null }; %>
    <div class="row g-3 mb-4">
      <div class="col-6 col-xl-3"><div class="card kpi">
        <div class="kpi-label">Messages</div>
        <div class="kpi-value"><%= k.total.toLocaleString('en-US') %></div>
        <div class="kpi-sub"><%= k.inFlight %> in flight</div>
      </div></div>
      <div class="col-6 col-xl-3"><div class="card kpi">
        <div class="kpi-label">Delivery rate</div>
        <div class="kpi-value <%= k.deliveryRate === null ? '' : (k.deliveryRate >= 90 ? 'kpi-good' : 'kpi-bad') %>"><%= k.deliveryRate === null ? '—' : k.deliveryRate + '%' %></div>
        <div class="kpi-sub">delivered ÷ (delivered + failed)</div>
      </div></div>
      <div class="col-6 col-xl-3"><div class="card kpi">
        <div class="kpi-label">Delivered</div>
        <div class="kpi-value"><%= k.delivered.toLocaleString('en-US') %></div>
        <div class="kpi-sub"><%= k.read %> read</div>
      </div></div>
      <div class="col-6 col-xl-3"><div class="card kpi">
        <div class="kpi-label">Failed</div>
        <div class="kpi-value <%= k.failed > 0 ? 'kpi-bad' : '' %>"><%= k.failed.toLocaleString('en-US') %></div>
        <div class="kpi-sub">check error codes below</div>
      </div></div>
    </div>

    <div class="row g-3 mb-4">
      <% var checks = (typeof setupChecks !== 'undefined' && setupChecks) ? setupChecks : []; %>
      <% if (checks.length) { %>
      <div class="col-lg-5">
        <div class="card h-100">
          <div class="card-header d-flex justify-content-between align-items-center">
            <span>Go-live checklist</span>
            <% if (setupDone) { %><span class="badge bg-success">Ready</span><% } else { %><span class="badge bg-warning">Action needed</span><% } %>
          </div>
          <div class="card-body py-2">
            <ul class="check-list small">
              <% checks.forEach(function (c) { %>
                <li>
                  <span class="check-dot <%= c.ok ? 'ok' : 'no' %>"><%= c.ok ? '✓' : '!' %></span>
                  <div><div class="fw-semibold"><%= c.label %></div><% if (!c.ok) { %><div class="text-muted"><%= c.hint %></div><% } %></div>
                </li>
              <% }); %>
              <li>
                <span class="check-dot warn">i</span>
                <div><div class="fw-semibold">Webhook callback URL</div><code><%= webhookUrl %></code><div class="text-muted">Subscribe to the <strong>messages</strong> field in Meta.</div></div>
              </li>
            </ul>
          </div>
        </div>
      </div>
      <% } %>
      <div class="<%= checks.length ? 'col-lg-7' : 'col-12' %>">
        <div class="row g-3">
          <div class="col-sm-6"><a href="/validate" class="text-decoration-none text-reset"><div class="card h-100"><div class="card-body action-tile">
            <span class="action-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/></svg></span>
            <div><h2 class="h6 mb-1">Validate a number</h2><p class="text-muted small mb-0">Tier A format &amp; Tier B deliverability.</p></div>
          </div></div></a></div>
          <div class="col-sm-6"><a href="/validate/bulk" class="text-decoration-none text-reset"><div class="card h-100"><div class="card-body action-tile">
            <span class="action-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></span>
            <div><h2 class="h6 mb-1">Bulk validate (CSV)</h2><p class="text-muted small mb-0">Clean a list before you send.</p></div>
          </div></div></a></div>
          <div class="col-sm-6"><a href="/messages" class="text-decoration-none text-reset"><div class="card h-100"><div class="card-body action-tile">
            <span class="action-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4z"/></svg></span>
            <div><h2 class="h6 mb-1">Send a message</h2><p class="text-muted small mb-0">Single template or free text.</p></div>
          </div></div></a></div>
          <div class="col-sm-6"><a href="/settings/api-keys" class="text-decoration-none text-reset"><div class="card h-100"><div class="card-body action-tile">
            <span class="action-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 18l6-6-6-6"/><path d="M8 6l-6 6 6 6"/></svg></span>
            <div><h2 class="h6 mb-1">Connect a project</h2><p class="text-muted small mb-0">Create an API key, send from any app.</p></div>
          </div></div></a></div>
        </div>

        <div class="card mt-3">
          <div class="card-body small">
            <div class="d-flex gap-2 mb-2">
              <span class="badge bg-success">Tier A</span>
              <span><strong>Format check</strong> — free, instant. Does <strong>not</strong> confirm the number is on WhatsApp.</span>
            </div>
            <div class="d-flex gap-2 mb-2">
              <span class="badge bg-primary">Tier B</span>
              <span><strong>Deliverability</strong> — a real template send. <span class="text-danger">Billed by Meta</span>; result arrives via webhook.</span>
            </div>
            <div class="text-muted">
              <strong>Templates are the default send path.</strong> Free text is only deliverable inside an open 24-hour session window.
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-4">
      <!-- Recent validations (Req 2, 3) -->
      <div class="col-lg-6">
        <div class="card h-100">
          <div class="card-header d-flex justify-content-between align-items-center">
            <span>Recent validations</span>
            <a href="/validate" class="small">Validate →</a>
          </div>
          <div class="table-responsive">
            <table class="table table-sm table-hover small align-middle mb-0">
              <thead>
                <tr><th>Input</th><th>E.164</th><th>Tier</th><th>Result</th><th>When</th></tr>
              </thead>
              <tbody>
                <% var validations = (typeof recentValidations !== 'undefined' && recentValidations) ? recentValidations : []; %>
                <% if (validations.length) { %>
                  <% validations.forEach(function (v) { %>
                    <%
                      var isTierB = v.check_type === 'deliverability';
                      var tierLabel = isTierB ? 'Tier B' : 'Tier A';
                      var tierClass = isTierB ? 'bg-primary' : 'bg-success';
                      var resultClass = 'bg-secondary';
                      if (v.status === 'valid' || v.status === 'accepted') resultClass = 'bg-success';
                      else if (v.status === 'invalid' || v.status === 'failed') resultClass = 'bg-danger';
                      else if (v.status === 'pending') resultClass = 'bg-warning text-dark';
                    %>
                    <tr>
                      <td class="text-truncate" style="max-width: 120px;"><%= v.raw_input %></td>
                      <td><%= v.e164 || '—' %></td>
                      <td><span class="badge <%= tierClass %>"><%= tierLabel %></span></td>
                      <td><span class="badge <%= resultClass %>"><%= v.status %></span></td>
                      <td class="text-muted"><%= v.created_at %></td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr><td colspan="5" class="text-muted">No validations yet.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Recent messages (Req 5) -->
      <div class="col-lg-6">
        <div class="card h-100">
          <div class="card-header d-flex justify-content-between align-items-center">
            <span>Recent messages</span>
            <a href="/messages" class="small">Send →</a>
          </div>
          <div class="table-responsive">
            <table class="table table-sm table-hover small align-middle mb-0">
              <thead>
                <tr><th>Recipient</th><th>Type</th><th>Status</th><th>When</th></tr>
              </thead>
              <tbody>
                <% var msgs = (typeof recentMessages !== 'undefined' && recentMessages) ? recentMessages : []; %>
                <% if (msgs.length) { %>
                  <% msgs.forEach(function (m) { %>
                    <%
                      var msgClass = 'bg-secondary';
                      if (m.status === 'read' || m.status === 'delivered') msgClass = 'bg-success';
                      else if (m.status === 'sent' || m.status === 'accepted') msgClass = 'bg-info text-dark';
                      else if (m.status === 'failed') msgClass = 'bg-danger';
                    %>
                    <tr>
                      <td><%= m.to_e164 %></td>
                      <td>
                        <span class="badge <%= m.msg_type === 'text' ? 'bg-warning text-dark' : 'bg-success' %>">
                          <%= m.msg_type === 'text' ? 'Free text' : 'Template' %>
                        </span>
                      </td>
                      <td><span class="badge <%= msgClass %>"><%= m.status %></span></td>
                      <td class="text-muted"><%= m.created_at %></td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr><td colspan="4" class="text-muted">No messages yet.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Active bulk jobs (Req 6, 8) -->
      <div class="col-12">
        <div class="card">
          <div class="card-header d-flex justify-content-between align-items-center">
            <span>Active bulk jobs</span>
            <a href="/bulk" class="small">All jobs →</a>
          </div>
          <div class="table-responsive">
            <table class="table table-sm table-hover small align-middle mb-0">
              <thead>
                <tr>
                  <th>#</th><th>Name</th><th>Template</th><th>Status</th>
                  <th style="min-width: 160px;">Progress</th><th>Created</th>
                </tr>
              </thead>
              <tbody>
                <% var jobs = (typeof activeJobs !== 'undefined' && activeJobs) ? activeJobs : []; %>
                <% if (jobs.length) { %>
                  <% jobs.forEach(function (j) { %>
                    <%
                      var doneCount = (j.sent_count || 0) + (j.failed_count || 0) + (j.skipped_count || 0);
                      var pct = j.total_count > 0 ? Math.round((doneCount / j.total_count) * 100) : 0;
                    %>
                    <tr>
                      <td><a href="/bulk/<%= j.id %>">#<%= j.id %></a></td>
                      <td><%= j.name || '—' %></td>
                      <td><%= j.template_name %> (<%= j.language %>)</td>
                      <td><span class="badge bg-primary"><%= j.status %></span></td>
                      <td>
                        <div class="progress" role="progressbar"
                             aria-label="Job #<%= j.id %> progress"
                             aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= pct %>"
                             style="height: 1rem;">
                          <div class="progress-bar" style="width: <%= pct %>%;"><%= pct %>%</div>
                        </div>
                        <div class="text-muted" style="font-size: 0.75rem;">
                          <%= j.sent_count %>/<%= j.total_count %> sent
                        </div>
                      </td>
                      <td class="text-muted"><%= j.created_at %></td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr><td colspan="6" class="text-muted">No active jobs.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </main>
</body>
</html>
