<!doctype html>
<html lang="en">
<head>
  <% title = 'Bulk send — WhatsApp Messaging'; %>
  <%- include('partials/head', { title: title }) %>
</head>
<body>
  <%- include('partials/navbar', { username: username, active: 'bulk' }) %>

  <main class="container py-4">
    <%- include('partials/flash') %>
    <h1 class="h3 mb-3">Bulk WhatsApp send (CSV)</h1>

    <div class="alert alert-warning" role="alert">
      <strong>Queued send.</strong> Uploading a recipient CSV creates a job. Every
      row is format-checked (<span class="badge bg-success">Tier A</span>) on import; invalid rows are recorded as
      <code>skipped_invalid</code> and never sent. Valid rows are queued and sent
      by the background worker, one at a time, with a rate-limit delay.
    </div>

    <% if (typeof created !== 'undefined' && created) { %>
      <div class="alert alert-success" role="alert">
        Created job <strong>#<%= created.jobId %></strong> (<%= created.status %>):
        <span class="badge bg-secondary">Total <%= created.total %></span>
        <span class="badge bg-primary">Queued <%= created.pending %></span>
        <span class="badge bg-warning text-dark">Skipped <%= created.skipped %></span>
      </div>
    <% } %>

    <div class="row">
      <div class="col-lg-5">
        <form id="bulk-send-form" class="card" enctype="multipart/form-data">
          <div class="card-body">
            <!-- CSRF token sent via the x-csrf-token HEADER (multer parses the
                 multipart body after the CSRF middleware runs). -->
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

            <h2 class="h5 card-title">Create a job</h2>

            <div class="mb-3">
              <label for="name" class="form-label">Job name (optional)</label>
              <input type="text" class="form-control" id="name" name="name" placeholder="April promo" autocomplete="off" />
            </div>

            <div class="mb-3">
              <label for="file" class="form-label">Recipient CSV</label>
              <input type="file" class="form-control" id="file" name="file" accept=".csv" required />
              <div class="form-text">A header row is required. Max size is enforced by the server.</div>
            </div>

            <div class="row">
              <div class="col-8 mb-3">
                <label for="templateName" class="form-label">Template name</label>
                <input type="text" class="form-control" id="templateName" name="templateName" placeholder="hello_world" autocomplete="off" required />
              </div>
              <div class="col-4 mb-3">
                <label for="language" class="form-label">Language</label>
                <input type="text" class="form-control" id="language" name="language" value="en_US" autocomplete="off" required />
              </div>
            </div>

            <div class="mb-3">
              <label for="phoneColumn" class="form-label">Phone column</label>
              <input type="text" class="form-control" id="phoneColumn" name="phoneColumn" value="phone" autocomplete="off" />
              <div class="form-text">Header name of the column holding the number (default <code>phone</code>).</div>
            </div>

            <div class="mb-3">
              <label for="defaultCountry" class="form-label">Default country (optional)</label>
              <input type="text" class="form-control" id="defaultCountry" name="defaultCountry" placeholder="US" maxlength="2" autocomplete="off" />
              <div class="form-text">ISO 3166 alpha-2 fallback for national-format numbers.</div>
            </div>

            <hr />
            <h3 class="h6">Variable mapping</h3>
            <p class="form-text mt-0">
              Map each template variable position (<code>{{1}}</code>,
              <code>{{2}}</code>, …) to a CSV column. Leave blank to send a
              template with no variables.
            </p>

            <div class="mb-2">
              <label for="varColumn1" class="form-label small mb-0">Variable {{1}} ← column</label>
              <input type="text" class="form-control" id="varColumn1" name="varColumn" placeholder="first_name" autocomplete="off" />
            </div>
            <div class="mb-2">
              <label for="varColumn2" class="form-label small mb-0">Variable {{2}} ← column</label>
              <input type="text" class="form-control" id="varColumn2" name="varColumn" placeholder="city" autocomplete="off" />
            </div>
            <div class="mb-3">
              <label for="varColumn3" class="form-label small mb-0">Variable {{3}} ← column</label>
              <input type="text" class="form-control" id="varColumn3" name="varColumn" placeholder="" autocomplete="off" />
            </div>

            <button type="submit" class="btn btn-success">Create bulk job</button>
            <div id="create-error" class="text-danger small mt-2"></div>
            <div id="create-ok" class="text-success small mt-2"></div>
          </div>
        </form>
      </div>

      <div class="col-lg-7">
        <div class="card">
          <div class="card-body">
            <h2 class="h5 card-title">Jobs</h2>
            <div class="table-responsive" style="max-height: 560px;">
              <table class="table table-sm table-striped small align-middle">
                <thead>
                  <tr>
                    <th>#</th><th>Name</th><th>Template</th><th>Status</th>
                    <th style="min-width: 160px;">Progress</th><th>Skipped</th><th>Created</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (typeof jobs !== 'undefined' && jobs.length) { %>
                    <% jobs.forEach(function (j) { %>
                      <%
                        // X-of-Y progress bar (Requirement 8.1). "Done" counts
                        // items that reached a terminal state (sent + failed +
                        // skipped) against the job total.
                        var doneCount = (j.sent_count || 0) + (j.failed_count || 0) + (j.skipped_count || 0);
                        var pct = j.total_count > 0 ? Math.round((doneCount / j.total_count) * 100) : 0;
                      %>
                      <tr>
                        <td><a href="/bulk/<%= j.id %>">#<%= j.id %></a></td>
                        <td><%= j.name || '—' %></td>
                        <td><%= j.template_name %> (<%= j.language %>)</td>
                        <td><span class="badge bg-secondary"><%= j.status %></span></td>
                        <td>
                          <div class="progress" role="progressbar"
                               aria-label="Job #<%= j.id %> progress"
                               aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= pct %>"
                               style="height: 1rem;">
                            <div class="progress-bar" style="width: <%= pct %>%;"><%= pct %>%</div>
                          </div>
                          <div class="text-muted" style="font-size: 0.75rem;">
                            <%= j.sent_count %>/<%= j.total_count %> sent
                          </div>
                        </td>
                        <td><%= j.skipped_count %></td>
                        <td class="text-muted"><%= j.created_at %></td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr><td colspan="7" class="text-muted">No jobs yet.</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script>
    (function () {
      var form = document.getElementById('bulk-send-form');
      var errorBox = document.getElementById('create-error');
      var okBox = document.getElementById('create-ok');

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        errorBox.textContent = '';
        okBox.textContent = '';
        var fd = new FormData(form);
        fd.append('format', 'json');
        fetch('/bulk', {
          method: 'POST',
          // CSRF token via header (multipart body is parsed after CSRF check).
          headers: { 'x-csrf-token': form._csrf.value, 'Accept': 'application/json' },
          body: fd,
        })
          .then(function (res) { return res.json(); })
          .then(function (data) {
            if (data && data.ok) {
              okBox.textContent =
                'Created job #' + data.jobId + ' (' + data.status + '): ' +
                data.counts.total + ' total, ' + data.counts.pending +
                ' queued, ' + data.counts.skipped + ' skipped. Reloading…';
              setTimeout(function () { window.location.reload(); }, 900);
            } else {
              errorBox.textContent = (data && data.message) || 'Create failed.';
            }
          })
          .catch(function () { errorBox.textContent = 'Create failed.'; });
      });
    })();
  </script>
</body>
</html>
