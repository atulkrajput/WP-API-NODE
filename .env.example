# ---------------------------------------------------------------------------
# WhatsApp Validation & Messaging MVP — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- App ---
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-string
# Force secure cookies (auto-on in production). Set to true behind HTTPS.
SESSION_COOKIE_SECURE=false

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=whatsapp_mvp

# --- Admin (used by the seed script only) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# --- Meta WhatsApp Cloud API ---
GRAPH_VERSION=v21.0
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WABA_ID=
# Webhook signature verification (X-Hub-Signature-256)
APP_SECRET=
# Webhook GET handshake verify token
WEBHOOK_VERIFY_TOKEN=
# Outbound request timeout (ms)
META_TIMEOUT_MS=15000

# --- Tier B deliverability probe template ---
PROBE_TEMPLATE_NAME=hello_world
PROBE_TEMPLATE_LANG=en_US

# --- Bulk worker / rate limiting ---
SEND_DELAY_MS=1000
WORKER_INTERVAL_SEC=5
WORKER_BATCH=5
MAX_ATTEMPTS=3

# --- Queue driver ---
# db (default, no Redis) | bullmq (opt-in)
# The default `db` driver needs NO Redis and NO extra packages.
# To use `bullmq`: run `npm install bullmq ioredis` (they are optional deps,
# not installed by default) and set REDIS_URL below.
QUEUE_DRIVER=db
# Only required when QUEUE_DRIVER=bullmq (e.g. redis://127.0.0.1:6379)
REDIS_URL=

# --- Uploads ---
# Max CSV upload size in bytes (default 5 MB)
UPLOAD_MAX_BYTES=5242880
